API_IMAGE_PROVIDER_NAME=main
API_IMAGE_BASE_URL=https://provider.example/v1
API_IMAGE_API_KEY=replace_with_your_provider_key

# Optional. Use this only when the provider model name is not gpt-image-2.
# API_IMAGE_MODEL=gpt-image-2

# Optional fallback providers. The script tries these in numeric order when the
# current provider has a retryable channel error such as timeout, connection
# failure, HTTP 429, or HTTP 5xx.
# API_IMAGE_FALLBACK_1_NAME=backup-a
# API_IMAGE_FALLBACK_1_BASE_URL=https://backup-provider.example/v1
# API_IMAGE_FALLBACK_1_API_KEY=replace_with_backup_provider_key
# API_IMAGE_FALLBACK_1_MODEL=gpt-image-2
#
# API_IMAGE_FALLBACK_2_NAME=backup-b
# API_IMAGE_FALLBACK_2_BASE_URL=https://second-backup-provider.example/v1
# API_IMAGE_FALLBACK_2_API_KEY=replace_with_second_backup_provider_key
# API_IMAGE_FALLBACK_2_MODEL=gpt-image-2
